# تنظیمات استقرار پروداکشن — این فایل را به .env کپی کنید و رمزها را عوض کنید
# deploy-debian.sh در صورت نبودِ .env خودش این فایل را با رمزهای تصادفی می‌سازد

# پورتی که سامانه روی هاست لیسن می‌کند
APP_PORT=8080

# PostgreSQL (داخل کانتینر؛ روی هاست فقط از 127.0.0.1 در دسترس است)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_HOST_PORT=5432

# Redis
REDIS_HOST_PORT=6379

# MinIO (بایگانی مدارک)
MINIO_ROOT_USER=afagh
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_SECRET
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=afagh-archive

# ── مقادیر اختیاری سرویس‌های بیرونی ──
# همهٔ این‌ها از پنل مدیر (پیکربندی سامانه) هم قابل تنظیم‌اند؛ ENV فقط مقدار پیش‌فرض است.
AFAGH_PUBLIC_BASE_URL=https://edu.example.ac.ir
