# تنظیمات استقرار پروداکشن — این فایل را به .env کپی کنید و رمزها را عوض کنید
# deploy-debian.sh در صورت نبودِ .env خودش این فایل را با رمزهای تصادفی می‌سازد

# پورتی که سامانه روی هاست لیسن می‌کند
APP_PORT=8080

# ── حافظهٔ بیلد ایمیج ──
# «next build» حافظه‌بر است؛ روی سرور بدون swap با «exit code: 137» کشته می‌شود.
# اول swap بسازید:  sudo bash scripts/ensure-build-memory.sh
# سقف هیپ را متناسب RAM بگذارید: <۱٫۵G→1024 | <۲٫۵G→1536 | <۴G→2048 | بیشتر→3072
# (اندازه‌گیری واقعی: اوج مصرف بیلد این پروژه ۴۱۲MB است، پس ۱۵۳۶ هم کافی است)
# NODE_MAX_OLD_SPACE=1536
# سوییچ bundler (اختیاری): NEXT_BUILD_ARGS=--webpack

# ── سه رمز زیر *اجباری*اند (P0-1) ──
# compose دیگر هیچ پیش‌فرضی برای آن‌ها ندارد؛ اگر در .env نباشند،
# «docker compose up» با پیام فارسی رد می‌شود (قدیم با «afagh» بالا می‌آمد!).
# خودساخته:  ./deploy-debian.sh        دستی:  node afagh-next/scripts/lib/secret-policy.mjs --gen
# سیاست (طول/نمونه/پیش‌فرض ضعیف):  afagh-next/scripts/lib/secret-policy.mjs
#   · POSTGRES_PASSWORD و AFAGH_APP_DB_PASSWORD: حداقل ۲۴ کاراکتر
#   · MINIO_ROOT_PASSWORD: حداقل ۱۶ کاراکتر
# بررسی:  make check-env
# برای توسعهٔ محلی (فقط!):  ALLOW_WEAK_SECRETS=1 make up

# PostgreSQL (داخل کانتینر؛ روی هاست فقط از 127.0.0.1 در دسترس است)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_HOST_PORT=5432

# ── نقش محدود اپلیکیشن (افزایش امنیت — ④) ──
# hardening.mjs هنگام بوت migrator این رمز را روی کاربر afagh_app اعمال می‌کند
# (این کاربر فقط با RLS به ۴ جدول محرمانه دسترسی دارد — بدون BYPASSRLS).
# این رمز هم‌اکنون hardening.mjs را هم فعال می‌کند: اگر ضعیف/نمونه باشد،
# گام سخت‌سازی *متوقف* می‌شود و اپ استارت نمی‌خورد (فیلدِ امنیتی نبودن، بهتر از
# نقشِ با رمز قابل‌حدس است).
AFAGH_APP_DB_PASSWORD=CHANGE_ME_STRONG_APP_DB_PASSWORD

# ── پشتیبان و بازیابی (P0-2) ──
# مسیر پشتیبان *داخل* کانتینر migrator؛ این پوشه volume است (afagh_backups) و
# با «docker compose down» حذف نمی‌شود. پشتیبان = pg_dump -Fc + امضای sha256 + فایل LATEST.
# AFAGH_BACKUP_DIR=/backups
# چند پشتیبان آخر نگه داشته شود (پیش‌فرض ۱۴):
# AFAGH_BACKUP_KEEP=14
# دستورهای اپراتور:  make backup · make verify-backup · make drill · make copy-backups-to-host
# ⚠ «پشتیبانی که بازگردانی نشده، پشتیبان نیست» — make drill را ماهی یک‌بار اجرا کنید
#   و حداقل یک نسخه را بیرون از سرور (NAS/دیسک جداگانه) نگه دارید.

# ── سیاست مهاجرت (P0-3) ──
# پروداکشن دیگر «drizzle-kit push» نمی‌کند؛ همان مسیری که CI می‌زند:
#   پشتیبان → مهاجرت‌های نسخه‌دار (drizzle/*.sql + دفتر مهاجرت) → پچ‌ها → seed → hardening → verify-backup
# نصب‌های قدیمی که با push ساخته شده‌اند، در نخستین اجرا baseline خودکار می‌شوند.

# ── حساب اولیه (P0-4) ──
# در ایمیج تولید، حساب‌های دمو در زمان build قفل‌اند. مدیر اولیه با این ساخته می‌شود
# (رمز تصادفی + تغییر اجباری در اولین ورود؛ رمز در ترمینال چاپ نمی‌شود):
#   make admin
# برای جعبهٔ نمایشی که واقعاً دمو لازم دارد، *عمدی* بسازید:
#   AFAGH_DEMO_LOCK=0  (build arg — فقط روی سرور نمایشی داخل شبکهٔ محرمانه)

# ── حالت دمو (⑤) ──
# ۱ = حساب‌های دمو (شماره‌ملی‌های 0000000001 و …) ساخته/بازیابی می‌شوند.
# در production حتماً ۰ بماند — پیش‌فرض production بدون این متغیر هم «خاموش» است.
AFAGH_DEMO_MODE=0
# رمز حساب‌های دمو (دربارهٔ پیش‌فرض 123456؛ در محیط دمو قابل تغییر)
# AFAGH_DEMO_PASSWORD=123456

# ── RLS fail-closed (①) ──
# ⚠ در production «هیچ» escape hatch وجود ندارد: اگر زیرساخت RLS از دست برود،
# درخواست‌ها رد می‌شوند (حتی با هیچ ENV). این متغیر حذف شده است — عمداً.

# ── مجوز سطح-شیء مالی (بازبینی — بند ۳) ──
# all (پیش‌فرض) = کارشناس مالی به همهٔ دانشجویان؛ department = فقط دانشجوی گروه خودش
# AFAGH_OBJECT_SCOPE=department

# مبدأهای اضافی مجاز CSRF (در صورت iframe روی دامنهٔ دیگر) — با کاما جدا کنید
# ALLOWED_EXTRA_ORIGINS=https://portal.example.ac.ir

# Redis
REDIS_HOST_PORT=6379

# MinIO (بایگانی مدارک)
MINIO_ROOT_USER=afagh
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_SECRET
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=afagh-archive

# ── مقادیر اختیاری سرویس‌های بیرونی ──
# همهٔ این‌ها از پنل مدیر (پیکربندی سامانه) هم قابل تنظیم‌اند؛ ENV فقط مقدار پیش‌فرض است.
AFAGH_PUBLIC_BASE_URL=https://edu.example.ac.ir

# ── شهریه و امور مالی ──
# نحوهٔ محاسبهٔ شهریهٔ ثابت معادل‌سازی (دروس معادل‌سازی هر ۲۰ واحد در یک نیمسال ۰۰EQ ثبت می‌شوند)
#   ONCE     = یک بار به ازای هر دانشجو، روی اولین نیمسال معادل‌سازی (پیش‌فرض)
#   PER_TERM = به ازای هر نیمسال معادل‌سازی جداگانه
#   NONE     = بدون شهریهٔ ثابت (فقط شهریهٔ متغیر به ازای هر واحد)
# از پنل مدیر «موتور شهریه» هم قابل تغییر است و مقدار دیتابیس بر ENV مقدم است.
# AFAGH_EQUIV_FIXED_TUITION_MODE=ONCE

# ── امور مالی دانشجویان (کارتابل کارشناس مالی) ──
# چند روز پیش از سررسید چک، پیام یادآوری به دانشجو برود.
# چکِ گذشته از سررسید هم یک بار یادآوری می‌شود. از پنل «تنظیمات ← شهریه و امور مالی» هم قابل تغییر است.
# AFAGH_CHEQUE_REMIND_DAYS=7
#
# ۱ = پویش زمان‌بندی‌شده پیام بفرستد؛ ۰ = فقط فهرست آماده شود، پیامی نرود (حالت آزمایشی)
# AFAGH_CHEQUE_REMIND_ENABLED=1
#
# کلید فراخوانی پویش یادآوری چک — هدر x-cron-secret برای POST /api/cron/cheque-reminders
# نمونهٔ crontab:  0 8 * * * curl -fsS -X POST -H "x-cron-secret: ***" http://localhost:8080/api/cron/cheque-reminders
# FINANCE_CRON_SECRET=

# ── زمان‌بند پویش‌ها (سرویس scheduler در docker-compose) ──
# بدون این سرویس endpoint‌های /api/cron/* هرگز خودکار اجرا نمی‌شوند.
# همهٔ فاصله‌ها به دقیقه‌اند و از ENV می‌آیند، نه از کد.
# SCHEDULER_TICK_SECONDS=60              # فاصلهٔ بیدارشدن زمان‌بند (ثانیه)
# CHEQUE_REMIND_INTERVAL_MIN=60          # پویش یادآوری چک
# GRAD_SCAN_INTERVAL_MIN=1440            # پویش فارغ‌التحصیلی (روزانه)
# BI_REFRESH_INTERVAL_MIN=720            # تازه‌سازی گزارش‌های تحلیلی
# WORKFLOW_EVENTS_INTERVAL_MIN=60        # رویدادهای گردش کار
#
# 🔑 کلیدهای محرمانهٔ پویش‌ها دیگر الزامی نیستند: migrator (seed-base) هنگام
# نصب، هر کلید خالی را با یک مقدار تصادفی می‌سازد، در دیتابیس ثبت می‌کند و
# در volume مشترک `afagh_cron_secrets` (فایل /secrets/cron.env) می‌گذارد؛
# scheduler هم از همان volume می‌خواند. فقط اگر می‌خواهید کلید مشخصی باشد،
# همان را این‌جا بگذارید (در این صورت ENV بر تولید خودکار مقدم است):
# FINANCE_CRON_SECRET=
# GRAD_CRON_SECRET=
# BI_CRON_SECRET=   # مستقل از GRAD (M-3)

# ── کوکی نشست (ورود) ──
# auto = تشخیص خودکار: روی HTTPS ← SameSite=None+Secure ، روی HTTP ← SameSite=Lax بدون Secure
# اگر پشت پروکسی هستید و پروکسی هدر x-forwarded-proto نمی‌فرستد، دستی مقدار بدهید.
# AFAGH_COOKIE_SECURE=auto        # auto | true | false
# AFAGH_COOKIE_SAMESITE=auto      # auto | lax | none | strict
# BIGBLUEBUTTON_URL=https://vc.example.ac.ir/bigbluebutton/api
# BIGBLUEBUTTON_SECRET=
# MOODLE_URL=
# MOODLE_TOKEN=
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER=
# PAYMENT_PROVIDER=
# PAYMENT_MERCHANT_ID=
# PAYMENT_MERCHANT_KEY=
# IRANDOC_BASE_URL=
# KYC_BASE_URL=
# SAJJAD_BASE_URL=

# ── لاگ ساختاریافته (JSON) ──
# سطح لاگ و قالب خروجی؛ خروجی JSON مستقیماً به Loki/ELK یا docker logs می‌رود.
# LOG_LEVEL=info                  # debug | info | warn | error
# LOG_FORMAT=json                 # json | pretty  (پیش‌فرض: json در production)
# LOG_APP_NAME=afagh              # نام سرویس در فیلد app لاگ‌ها
