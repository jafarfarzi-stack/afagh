    "db:hardening": "node scripts/hardening.mjs",
    "db:base": "node scripts/seed-base.mjs",
    "db:permissions": "node scripts/seed-permissions.mjs",
    "test:rls": "node scripts/rls-test.mjs",
    "test:concurrency": "node scripts/concurrency-test.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
