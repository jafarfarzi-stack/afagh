# Afagh weekly UEMS sync - configuration template
# Copy this file to %USERPROFILE%\.afagh\uems-sync.env and fill in the values.
# NEVER commit the filled file. Lines starting with # are ignored.

# ---- Source: legacy UEMS / SQL Server ----
UEMS_SERVER=127.0.0.1,62133
UEMS_DB=uems
# 1 = Windows integrated auth (sqlcmd -E). 0 = SQL user/password below.
UEMS_TRUSTED=1
UEMS_USER=sa
UEMS_PASS=

# ---- Target: Afagh Postgres (must be reachable from THIS machine) ----
# 172.20.0.3 is a Docker-internal IP on the server and is NOT reachable
# from Windows. Use the server IP, an exposed port, or an SSH tunnel port.
TARGET_HOST=127.0.0.1
TARGET_PORT=5432
TARGET_DB=afagh_db
TARGET_USER=afagh
# Read by weekly-uems-sync.mjs as AFAGH_TARGET_PASSWORD.
# Keeping it in this file avoids showing the password in the process list.
AFAGH_TARGET_PASSWORD=

# ---- Behaviour ----
UNI=1
FIN_DIR=D:\backups\fin_export
# 1 = print the commands and exit without writing anything. Set 0 for a real run.
UEMS_SYNC_PLAN=1
# 1 = reuse existing TSVs instead of extracting from UEMS.
UEMS_SYNC_SKIP_EXTRACT=0
# Optional: folder holding uems_rates/ and uems_edu/ when skip-extract=1.
# UEMS_SYNC_WORK_DIR=D:\backups\uems_live_20261110
