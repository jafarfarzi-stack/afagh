# Afagh weekly UEMS sync - configuration template
# Copy this file to %USERPROFILE%\.afagh\uems-sync.env and fill in the values.
# NEVER commit the filled file. Lines starting with # are ignored.

# ---- Source: legacy UEMS / SQL Server ----
UEMS_SERVER=127.0.0.1,62133
UEMS_DB=uems
# 1 = Windows integrated auth (sqlcmd -E). 0 = SQL user/password below.
UEMS_TRUSTED=1
# UEMS_USER=sa
# UEMS_PASS=

# ---- Target: Afagh Postgres ----
# Postgres is NOT exposed on the server host. The launcher opens an SSH
# tunnel from Windows to the Docker-internal PG address and points the
# orchestrator at the local end of that tunnel.
TARGET_HOST=127.0.0.1
TARGET_PORT=15432
TARGET_DB=afagh_db
TARGET_USER=afagh

# ---- SSH tunnel (optional, set to 1 to enable) ----
UEMS_SYNC_SSH_TUNNEL=1
SSH_HOST=root@100.70.187.120
SSH_KEY=C:\Users\Farzi\.ssh\afagh_ed25519
PG_INTERNAL_HOST=172.20.0.5
TUNNEL_LOCAL_PORT=15432

# ---- Secret handling ----
# 1 = fetch POSTGRES_PASSWORD from the server .env over SSH at run time.
#     Recommended: no database password is stored on the Windows machine.
# 0 = put AFAGH_TARGET_PASSWORD=<password> in this file instead.
UEMS_SYNC_FETCH_DB_PASSWORD=1
# AFAGH_TARGET_PASSWORD=

# ---- Behaviour ----
UNI=1
FIN_DIR=D:\backups\fin_export
# 1 = print the commands and exit without writing anything. Set 0 for a real run.
UEMS_SYNC_PLAN=1
# 1 = reuse existing TSVs instead of extracting from UEMS.
UEMS_SYNC_SKIP_EXTRACT=0
# Optional: folder holding uems_rates/ and uems_edu/ when skip-extract=1.
# UEMS_SYNC_WORK_DIR=D:\backups\uems_live_20261110
