# ════════════════════════════════════════════════════════════════════
#  تنظیمات محیطی — هیچ مقداری در کد سامانه هارد‌کد نیست
#  اولویت: پنل مدیر (پیکربندی سامانه) ← این فایل (ENV) ← پیش‌فرض
#  کلیدهای بخش «زیرساخت» فقط از همین‌جا خوانده می‌شوند.
# ════════════════════════════════════════════════════════════════════

# ── زیرساخت (فقط ENV) ──
DATABASE_URL=postgres://afagh:afagh@localhost:5432/afagh_db
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
S3_BUCKET=afagh-archive
S3_ACCESS_KEY=afagh
S3_SECRET_KEY=afagh-secret
SQLITE_SOURCE=../afagh-erp/data/afagh.db
PORT=8080

# ── عمومی ──
AFAGH_UNIVERSITY_NAME=دانشگاه آفاق
AFAGH_PUBLIC_BASE_URL=http://localhost:8080
# کوکی نشست: auto ← روی HTTPS «None+Secure» و روی HTTP «Lax بدون Secure»
# AFAGH_COOKIE_SECURE=auto        # auto | true | false
# AFAGH_COOKIE_SAMESITE=auto      # auto | lax | none | strict
# AFAGH_SUPPORT_EMAIL=
# AFAGH_SUPPORT_PHONE=

# ── کلاس مجازی (BigBlueButton / Moodle) ──
# BIGBLUEBUTTON_URL=https://vc.example.ac.ir/bigbluebutton/api
# BIGBLUEBUTTON_SECRET=
# BIGBLUEBUTTON_MODERATOR_PW=
# BIGBLUEBUTTON_ATTENDEE_PW=
# BIGBLUEBUTTON_AUTO_RECORD=false
# MOODLE_URL=
# MOODLE_TOKEN=

# ── پیامک و ربات‌ها ──
# SMS_PROVIDER=KAVENEGAR
# SMS_API_KEY=
# SMS_SENDER=
# BALE_BOT_TOKEN=
# BALE_CHANNEL_ID=
# EITAA_BOT_TOKEN=
# EITAA_CHANNEL_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# نشانی سرویس پیامک (خالی = پیش‌فرض سرویس‌دهنده). برای SMS_PROVIDER=CUSTOM
# می‌توانید هر سرویس داخلی را با جای‌گاه‌های {to} {text} {sender} {key} وصل کنید:
# SMS_BASE_URL=https://sms.example.ir/send?to={to}&text={text}&from={sender}&key={key}
# TELEGRAM_API_BASE=https://api.telegram.org
# BALE_API_BASE=https://tapi.bale.ai
# EITAA_API_BASE=https://eitaayar.ir/api
# کانال‌های اعلان به دانشجو/کاربر (با ویرگول): INAPP,SMS,TELEGRAM,BALE,EITAA
# NOTIFY_CHANNELS=INAPP,SMS
# NOTIFY_ENABLED=true
# NOTIFY_SIGNATURE=دانشگاه آفاق

# ── درگاه پرداخت ──
# PAYMENT_PROVIDER=
# PAYMENT_TERMINAL_ID=
# PAYMENT_MERCHANT_ID=
# PAYMENT_MERCHANT_KEY=
# PAYMENT_CALLBACK_URL=
# PAYMENT_SANDBOX=true
# PAYMENT_WAGE_PERCENT=0

# ── سرویس‌های استعلام ──
# IRANDOC_BASE_URL=
# IRANDOC_TOKEN=
# KYC_BASE_URL=
# KYC_API_KEY=
# SHAPARAK_BASE_URL=
# SAJJAD_BASE_URL=
SAJJAD_PORTAL_URL=https://portal.saorg.ir
# API_TIMEOUT_SECONDS=10

# ── فارغ‌التحصیلی و صدور مدارک (همه از پنل مدیر هم قابل تغییرند) ──
# GRAD_AUTO_SCAN=true
# GRAD_MIN_GPA=12
# GRAD_THESIS_DEGREE_CODES=MSC,PHD
# GRAD_IRANDOC_MAX_SIMILARITY=20
# GRAD_REQUIRE_SAJJAD=true
# GRAD_REQUIRE_PHOTO=true
# GRAD_STAMP_FEE=0
# GRAD_SERIAL_PREFIX=AF
# GRAD_CRON_SECRET=
# ALUMNI_FEE_TRANSCRIPT=0
# ALUMNI_FEE_RELEASE=0
# ALUMNI_FEE_TRANSLATION=0
# ALUMNI_FEE_DUPLICATE=0

# ── گردش کار و حق‌التدریس (همه از پنل مدیر هم قابل تغییرند) ──
# WORKFLOW_WEBHOOK_URL=
# REQ_TRACKING_PREFIX=REQ
# FA_YEAR=
# PAYROLL_TERM_SESSIONS=16
# PAYROLL_MIDTERM_PERCENT=40
# PAYROLL_CROWDED_THRESHOLD=40
# PAYROLL_COEF_PRACTICAL=ضریب درس عملی
# PAYROLL_COEF_MS_LEVEL=ضریب مقطع ارشد
# PAYROLL_COEF_CROWDED=ضریب کلاس جمعی (>۴۰ نفر)
# PAYROLL_MS_COURSE_PREFIX=TH

# ── ارزشیابی و هوش تجاری BI (همه از پنل مدیر هم قابل تغییرند) ──
# EVAL_FLAG_THRESHOLD=3.5
# EVAL_FACILITY_REPAIR_THRESHOLD=3
# EVAL_TREND_TERMS=3
# BI_WORDCLOUD_LIMIT=18
# BI_WORDCLOUD_MIN_LEN=3
# BI_CACHE_TTL_SECONDS=300
# BI_STOPWORDS=و,به,از,که,در,...
# PERF_SLA_TARGET=90
# PERF_EVAL_TARGET=4
# PERF_SESSION_HOLD_TARGET=90
# PERF_INCENTIVE_PERCENT=10
# PAYROLL_MS_COURSE_PREFIX=21

# ── استعلام عمومی: کارت دانشجویی، کارت آزمون و گواهینامه ──
# کلید امضای توکن کارت ورود به جلسه (HMAC-SHA256). اگر خالی بماند صدور کارت
# آزمون با خطای صریح متوقف می‌شود — هیچ مقدار پیش‌فرضی در کد نیست.
# TICKET_TOKEN_SECRET=
# مدت اعتبار کارت ورود به جلسه، به دقیقه (سقف اجرا ۷۲ ساعت)
# EXAM_TICKET_TTL_MINUTES=180
# اعتبار پیش‌فرض کارت دانشجویی، به روز
# STUDENT_CARD_VALID_DAYS=365

# ── امنیت ──
# AFAGH_SCRYPT_N=16384
